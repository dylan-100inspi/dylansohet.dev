---
import { useTranslations } from '../i18n/translations';
import type { Locale } from '../i18n/translations';
import { X } from '@lucide/astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const message = t('easterEgg.message');
const closeLabel = t('easterEgg.close');

const modelSrc = '/models/crystal-key.glb';
---

<dialog class="egg-dialog" data-easter-egg aria-label={message} tabindex="-1">
  <!-- src + auto-rotate are added on trigger, when the model-viewer module is lazy-loaded (scripts/konami.ts). -->
  <model-viewer
    data-easter-egg-model
    data-src={modelSrc}
    camera-controls
    disable-zoom
    disable-pan
    interaction-prompt="none"
    auto-rotate-delay="0"
    rotation-per-second="20deg"
    orientation="0deg -90deg 0deg"
    camera-orbit="180deg 90deg 105%"
    environment-image="neutral"
    shadow-intensity="0"
    alt={message}
  >
  </model-viewer>
  <p class="egg-caption">{message}</p>
  <button type="button" class="egg-close" data-easter-egg-close aria-label={closeLabel}>
    <X class="h-5 w-5" aria-hidden="true" />
  </button>
</dialog>

<style>
  @reference '../styles/global.css';

  @layer components {
    .egg-dialog {
      width: 100vw;
      height: 100dvh;
      max-width: 100vw;
      max-height: 100dvh;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      overflow: hidden;
    }

    /* A closed dialog must stay hidden; our layered display rule would otherwise
       override the UA `display: none` and leak the caption onto the page. */
    .egg-dialog:not([open]) {
      display: none;
    }

    /* Full-viewport so a click/tap anywhere outside the model closes it. */
    .egg-dialog[open] {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      background:
        radial-gradient(circle at 50% 44%, rgb(45 212 191 / 0.14), transparent 42%),
        radial-gradient(ellipse at center, transparent 55%, rgb(2 6 23 / 0.55));
    }

    /* Suppress the focus ring on the dialog (can briefly catch focus before
       model-viewer upgrades) and the model itself. */
    .egg-dialog:focus,
    .egg-dialog:focus-visible {
      outline: none;
    }

    .egg-dialog::backdrop {
      background: rgb(2 6 23 / 0.6);
      backdrop-filter: blur(10px);
    }

    .egg-dialog model-viewer {
      width: min(90vw, 40rem);
      height: min(80dvh, 40rem);
      background: transparent;
      --poster-color: transparent;
      /* Hidden until the model actually loads; revealed via `.is-revealed` (konami.ts). */
      opacity: 0;
      outline: none;
    }

    .egg-dialog model-viewer.is-revealed {
      opacity: 1;
      transform: none;
    }

    .egg-dialog model-viewer::part(default-progress-bar) {
      display: none;
    }

    .egg-caption {
      font-family: var(--font-mono, ui-monospace, 'SFMono-Regular', monospace);
      font-size: 0.9375rem;
      letter-spacing: 0.02em;
      color: rgb(45 212 191);
      text-shadow: 0 1px 12px rgb(2 6 23 / 0.8);
    }

    /* Icon close button, touch-only. `.egg-touch` is added by konami.ts on coarse pointers;
       desktop closes via any key / tap-outside / Esc. */
    .egg-close {
      display: none;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      color: rgb(148 163 184);
      border: 1px solid rgb(148 163 184 / 0.3);
      border-radius: 9999px;
      background: rgb(15 23 42 / 0.5);
      outline: none;
      transition:
        color 150ms ease,
        border-color 150ms ease,
        background-color 150ms ease;
    }

    .egg-dialog.egg-touch .egg-close {
      display: inline-flex;
    }

    .egg-close:hover,
    .egg-close:focus-visible {
      color: rgb(226 232 240);
      border-color: rgb(45 212 191 / 0.6);
      background: rgb(45 212 191 / 0.12);
    }

    @media (prefers-reduced-motion: no-preference) {
      .egg-dialog model-viewer {
        transform: scale(0.92);
        transition:
          opacity 340ms ease-out,
          transform 340ms ease-out;
      }

      .egg-dialog[open] .egg-caption {
        animation: egg-caption-in 420ms ease-out;
      }
    }

    @keyframes egg-caption-in {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
