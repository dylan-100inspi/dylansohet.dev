---
import { ExternalLink } from '@lucide/astro';
import ProjectThumbnail from './ProjectThumbnail.astro';
import type { ProjectScreenshot } from './ProjectThumbnail.astro';
import GithubIcon from '../../assets/icons/github.svg';
import { useTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

export interface Project {
  readonly id: string;
  readonly title: string;
  readonly description: string;
  readonly tags: readonly string[];
  readonly repoUrl: string;
  readonly liveUrl?: string;
  readonly screenshot?: ProjectScreenshot | undefined;
}

interface Props {
  readonly project: Project;
  readonly locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
---

<article
  class="reveal flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white/60 dark:border-slate-800 dark:bg-slate-900/40 sm:flex-row"
>
  <div class="sm:w-72 sm:shrink-0">
    <ProjectThumbnail
      locale={locale}
      screenshot={project.screenshot}
      alt={`${project.title} preview`}
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-semibold text-slate-900 dark:text-slate-100">{project.title}</h3>
    <div class="mt-2 flex flex-wrap gap-2">
      {
        project.tags.map((tag) => (
          <span class="rounded-full border border-slate-300/80 bg-slate-200/70 px-3 py-1 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-800 dark:font-medium dark:text-teal-400">
            {tag}
          </span>
        ))
      }
    </div>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      {project.description}
    </p>
    <div class="mt-4 flex items-center gap-4 border-t border-slate-200 pt-4 dark:border-slate-800">
      <a
        href={project.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-600 transition-colors hover:text-teal-500 dark:text-teal-400 dark:hover:text-teal-300"
      >
        <GithubIcon class="h-4 w-4" />
        {t('projects.viewRepo')}
      </a>
      {
        project.liveUrl && (
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-600 transition-colors hover:text-teal-500 dark:text-teal-400 dark:hover:text-teal-300"
          >
            {t('projects.viewLive')}
            <ExternalLink class="h-4 w-4" />
          </a>
        )
      }
    </div>
  </div>
</article>
