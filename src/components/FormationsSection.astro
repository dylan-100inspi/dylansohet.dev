---
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/translations';
import type { Locale } from '../i18n/translations';
import { GraduationCap, ExternalLink } from '@lucide/astro';
import udemyLogo from '../assets/images/udemy-logo.svg';
import HenalluxLogo from '../assets/images/henallux-logo.svg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const formatMonth = (year: number, month: number) =>
  new Date(year, month).toLocaleDateString(locale, { month: 'long', year: 'numeric' });

const courses = [
  {
    title: 'Angular - The Complete Guide',
    issued: formatMonth(2026, 7),
    credentialId: 'UC-97b8a47e-2f62-4932-9d50-9dd44ecb6cb8',
    url: 'https://www.udemy.com/certificate/UC-97b8a47e-2f62-4932-9d50-9dd44ecb6cb8/',
  },
  {
    title: 'AI For Developers With GitHub Copilot, Cursor AI & ChatGPT',
    issued: formatMonth(2026, 4),
    credentialId: 'UC-593ce0d8-5c89-48fe-be04-d8b7ba20850f',
    url: 'https://ude.my/UC-593ce0d8-5c89-48fe-be04-d8b7ba20850f/',
  },
  {
    title: "MongoDB - The Complete Developer's Guide",
    issued: formatMonth(2026, 1),
    credentialId: 'UC-33144e8f-ae91-4928-9aad-4cc9f02eb4ab',
    url: 'https://ude.my/UC-33144e8f-ae91-4928-9aad-4cc9f02eb4ab',
  },
  {
    title: 'Playwright: Web Automation Testing',
    issued: formatMonth(2025, 9),
    credentialId: 'UC-1eb5534d-9e08-4cbe-aec5-7e1ded36e545',
    url: 'https://ude.my/UC-1eb5534d-9e08-4cbe-aec5-7e1ded36e545',
  },
];
---

<section id="formations" class="py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6" data-reveal-stagger>
    <h2
      class="reveal text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50"
    >
      {t('formations.heading')}
    </h2>

    <!-- Education -->
    <h3
      class="reveal mt-8 text-sm font-semibold tracking-wide text-teal-600 uppercase dark:text-teal-400"
    >
      {t('formations.educationLabel')}
    </h3>
    <div
      class="reveal mt-4 flex items-center gap-4 rounded-xl border border-slate-200 bg-white/60 p-5 dark:border-slate-800 dark:bg-slate-900/40"
    >
      <HenalluxLogo
        width={40}
        height={40}
        role="img"
        aria-label="Henallux"
        class="h-10 w-10 shrink-0 rounded-lg bg-white p-0.5 ring-1 ring-slate-200 dark:ring-slate-700"
      />
      <div>
        <p class="font-semibold text-slate-900 dark:text-slate-100">{t('formations.degree')}</p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          <GraduationCap class="mr-1 inline h-4 w-4 align-text-bottom" />Henallux &middot; 2018 –
          2022
        </p>
      </div>
    </div>

    <!-- Certifications -->
    <h3
      class="reveal mt-10 text-sm font-semibold tracking-wide text-teal-600 uppercase dark:text-teal-400"
    >
      {t('formations.coursesLabel')}
    </h3>
    <div class="mt-4 grid auto-rows-fr gap-4 sm:grid-cols-2">
      {
        courses.map((course) => (
          <article class="reveal flex h-full flex-col rounded-xl border border-slate-200 bg-white/60 p-5 dark:border-slate-800 dark:bg-slate-900/40">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white p-1.5 ring-1 ring-slate-200 dark:ring-slate-700">
                <Image
                  src={udemyLogo}
                  alt="Udemy"
                  width={32}
                  height={32}
                  class="h-full w-full object-contain"
                />
              </div>
              <div class="min-w-0">
                <h4 class="font-semibold text-slate-900 dark:text-slate-100">{course.title}</h4>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                  Udemy &middot; {t('formations.issued')} {course.issued}
                </p>
              </div>
            </div>
            <p class="mt-auto pt-4 font-mono text-xs text-slate-400 dark:text-slate-500">
              {t('formations.credentialId')}: {course.credentialId}
            </p>
            <a
              href={course.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center gap-1.5 self-start text-sm font-medium text-teal-600 transition-colors hover:text-teal-500 dark:text-teal-400 dark:hover:text-teal-300"
            >
              {t('formations.viewCertificate')}
              <ExternalLink class="h-4 w-4" />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
