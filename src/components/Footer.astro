---
import { useTranslations } from '../i18n/translations';
import type { Locale } from '../i18n/translations';
import { Mail } from '@lucide/astro';
import GithubIcon from '../assets/icons/github.svg';
import LinkedinIcon from '../assets/icons/linkedin.svg';
import { author, site } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-950 text-slate-400">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col items-center gap-6 sm:flex-row sm:justify-between">
      <!-- Contact links -->
      <div class="flex items-center gap-4">
        <a
          href={`mailto:${author.email}`}
          class="inline-flex h-11 w-11 items-center justify-center rounded-lg transition-colors hover:bg-slate-800 hover:text-teal-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500"
          aria-label={t('contact.emailLabel')}
        >
          <Mail class="h-5 w-5" />
        </a>
        <a
          href={author.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 w-11 items-center justify-center rounded-lg transition-colors hover:bg-slate-800 hover:text-teal-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500"
          aria-label={t('contact.linkedinLabel')}
        >
          <LinkedinIcon class="h-5 w-5" />
        </a>
        <a
          href={author.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 w-11 items-center justify-center rounded-lg transition-colors hover:bg-slate-800 hover:text-teal-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500"
          aria-label={t('contact.githubLabel')}
        >
          <GithubIcon class="h-5 w-5" />
        </a>
      </div>

      <!-- Info -->
      <div class="flex flex-col items-center gap-1 text-sm sm:items-end">
        <p>&copy; {currentYear} {author.fullName}. {t('footer.rights')}</p>
        <p class="text-slate-400">
          <a
            href={site.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-sm transition-colors hover:text-teal-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500"
          >
            {t('footer.sourceCode')}
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
