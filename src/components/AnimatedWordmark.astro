---
// Animated "DYLAN </> SOHET" wordmark: Geist Mono, two-tone (surname + code mark teal).
// Words slide in from each side while the code mark spins into the gap on page load.
import { author } from '../config/site';

interface Props {
  /** Extra classes for the wrapper (sizing, layout) applied by the consumer. */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['wm', className]} data-wm aria-label={author.fullName}>
  <span class="wm-word wm-left" aria-hidden="true">DYLAN</span>
  <svg class="wm-code" viewBox="0 0 44 24" aria-hidden="true">
    <path
      class="wm-chevron"
      d="M14 5 L5 12 L14 19"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      class="wm-slash"
      d="M26 3 L18 21"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"></path>
    <path
      class="wm-chevron"
      d="M30 5 L39 12 L30 19"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="wm-word wm-right" aria-hidden="true">SOHET</span>
</span>

<style>
  .wm {
    display: inline-flex;
    align-items: center;
    gap: 0.14em;
    font-family: var(--font-geist-mono, ui-monospace, monospace);
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    user-select: none;
  }

  .wm-word {
    display: inline-block;
    color: var(--color-slate-50, #f8fafc);
    transform: skewX(-4deg);
    transform-origin: center;
  }

  .wm-right {
    color: var(--color-teal-400, #2dd4bf);
  }

  .wm-code {
    width: 1.5em;
    height: auto;
    flex-shrink: 0;
    overflow: visible;
    color: var(--color-teal-400, #2dd4bf);
    transform: skewX(-4deg);
    /* Nudge right so the italic words leave equal optical space on both sides. */
    margin-left: 0.09em;
  }

  .wm-left,
  .wm-right,
  .wm-code {
    opacity: 1;
    transform: skewX(-4deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wm.is-playing .wm-left {
      animation: wmLeft 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .wm.is-playing .wm-right {
      animation: wmRight 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .wm.is-playing .wm-code {
      animation: wmCode 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
    }
  }

  @keyframes wmLeft {
    from {
      opacity: 0;
      transform: skewX(-4deg) translateX(-3em);
    }
    to {
      opacity: 1;
      transform: skewX(-4deg) translateX(0);
    }
  }
  @keyframes wmRight {
    from {
      opacity: 0;
      transform: skewX(-4deg) translateX(3em);
    }
    to {
      opacity: 1;
      transform: skewX(-4deg) translateX(0);
    }
  }
  @keyframes wmCode {
    from {
      opacity: 0;
      transform: skewX(-4deg) rotate(-360deg) scale(0);
    }
    60% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: skewX(-4deg) rotate(0deg) scale(1);
    }
  }
</style>

<script>
  function playWordmarks() {
    document.querySelectorAll<HTMLElement>('[data-wm]').forEach((mark) => {
      mark.classList.add('is-playing');
    });
  }

  window.addEventListener('pageshow', playWordmarks);
</script>
